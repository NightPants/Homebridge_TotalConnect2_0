{
  "name": "homebridge-honeywell-totalconnect",
  "displayName": "Honeywell Total Connect 2.0",
  "version": "1.0.3",
  "description": "Control your Honeywell / Resideo Total Connect 2.0 alarm system from Apple HomeKit via Homebridge. Arm, disarm, zone sensors, bypass and more.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "NightPants",
  "funding": {
    "type": "paypal",
    "url": "https://www.paypal.com/ncp/payment/EGCFVVRYZCHXU"
  },
  "homepage": "https://github.com/NightPants/Homebridge_TotalConnect2_0#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NightPants/Homebridge_TotalConnect2_0.git"
  },
  "bugs": {
    "url": "https://github.com/NightPants/Homebridge_TotalConnect2_0/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "total connect",
    "totalconnect",
    "honeywell",
    "resideo",
    "alarmnet",
    "alarm",
    "security system",
    "vista",
    "lynx",
    "proa7"
  ],
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "icon.png"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "watch": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "homebridge": "^2.4.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
