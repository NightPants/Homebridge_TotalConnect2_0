{
  "pluginAlias": "HoyTotalConnect",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./homebridge-ui",
  "headerDisplay": "Control your Honeywell / Resideo **Total Connect 2.0** alarm from HomeKit. Use **Test Login & Discover** above to verify your account and see your location, partition and zone IDs.",
  "footerDisplay": "Tip: create a dedicated Total Connect user for Homebridge (without MFA) so you can revoke its access at any time. See the README for details.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Total Connect",
        "required": true
      },
      "username": {
        "title": "Total Connect Username",
        "type": "string",
        "required": true,
        "description": "Username (or email) you use to sign in to totalconnect2.com."
      },
      "password": {
        "title": "Total Connect Password",
        "type": "string",
        "required": true,
        "x-schema-form": { "type": "password" }
      },
      "userCode": {
        "title": "Panel User Code",
        "type": "string",
        "pattern": "^(-1|[0-9]{4,8})$",
        "description": "The 4-8 digit code you type on the keypad. Required by most panels to arm/disarm remotely. Leave blank if your panel does not need one.",
        "x-schema-form": { "type": "password" }
      },
      "locations": {
        "title": "Per-Location Settings",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "locationId": { "title": "Location ID", "type": "integer", "required": true },
            "name": { "title": "Display Name (optional)", "type": "string" },
            "userCode": {
              "title": "User Code Override",
              "type": "string",
              "pattern": "^(-1|[0-9]{4,8})$",
              "x-schema-form": { "type": "password" }
            },
            "enabled": { "title": "Enabled", "type": "boolean", "default": true }
          }
        }
      },
      "partitionMode": {
        "title": "Partitions",
        "type": "string",
        "default": "combined",
        "oneOf": [
          { "title": "One Security System for the whole location (all partitions)", "enum": ["combined"] },
          { "title": "A separate Security System for each partition", "enum": ["separate"] }
        ]
      },
      "homeMode": {
        "title": "HomeKit \"Home\" arms the panel as",
        "type": "string",
        "default": "stay",
        "oneOf": [
          { "title": "Stay", "enum": ["stay"] },
          { "title": "Stay - Instant (no entry delay)", "enum": ["stayInstant"] },
          { "title": "Night Stay", "enum": ["night"] },
          { "title": "Away", "enum": ["away"] },
          { "title": "Away - Instant", "enum": ["awayInstant"] }
        ]
      },
      "nightMode": {
        "title": "HomeKit \"Night\" arms the panel as",
        "type": "string",
        "default": "auto",
        "oneOf": [
          { "title": "Automatic (Night Stay if supported, otherwise Stay - Instant)", "enum": ["auto"] },
          { "title": "Night Stay", "enum": ["night"] },
          { "title": "Stay - Instant (no entry delay)", "enum": ["stayInstant"] },
          { "title": "Stay", "enum": ["stay"] },
          { "title": "Away", "enum": ["away"] },
          { "title": "Away - Instant", "enum": ["awayInstant"] },
          { "title": "Hide the Night option in HomeKit", "enum": ["disabled"] }
        ]
      },
      "awayMode": {
        "title": "HomeKit \"Away\" arms the panel as",
        "type": "string",
        "default": "away",
        "oneOf": [
          { "title": "Away", "enum": ["away"] },
          { "title": "Away - Instant (no entry delay)", "enum": ["awayInstant"] }
        ]
      },
      "allowDisarm": {
        "title": "Allow disarming from HomeKit",
        "type": "boolean",
        "default": true,
        "description": "Turn off to make HomeKit arm-only. Disarm requests will be rejected."
      },
      "autoBypassOnArm": {
        "title": "Auto-bypass open zones when arming fails",
        "type": "boolean",
        "default": false,
        "description": "If the panel refuses to arm because a door/window is open, bypass the open (bypassable) zones and try again. Bypassed zones are NOT protected while armed."
      },
      "autoBypassLowBattery": {
        "title": "Auto-bypass zones with a low battery (while disarmed)",
        "type": "boolean",
        "default": false
      },
      "armingSwitches": {
        "title": "Arm-only switches",
        "type": "array",
        "uniqueItems": true,
        "description": "Adds switches that arm the panel when turned on. They never disarm, so they are safe to use in automations that run without confirmation.",
        "items": {
          "type": "string",
          "oneOf": [
            { "title": "Arm Away", "enum": ["away"] },
            { "title": "Arm Home (Stay)", "enum": ["stay"] },
            { "title": "Arm Night", "enum": ["night"] }
          ]
        }
      },
      "bypassSwitches": {
        "title": "Add \"Bypass Open Zones\" and \"Clear Bypass\" buttons",
        "type": "boolean",
        "default": false
      },
      "alarmSensor": {
        "title": "Add an \"Alarm\" contact sensor (opens when the alarm is triggered)",
        "type": "boolean",
        "default": false,
        "description": "Useful for automations and critical notifications."
      },
      "zoneExposure": {
        "title": "Zone sensors",
        "type": "string",
        "default": "all",
        "oneOf": [
          { "title": "Show all zones", "enum": ["all"] },
          { "title": "Show only the zone IDs listed below", "enum": ["selected"] },
          { "title": "Do not show zones", "enum": ["none"] }
        ]
      },
      "zoneIds": {
        "title": "Zone IDs to show",
        "type": "array",
        "items": { "type": "integer" }
      },
      "excludeZoneIds": {
        "title": "Zone IDs to hide",
        "type": "array",
        "items": { "type": "integer" }
      },
      "hideButtonZones": {
        "title": "Hide key fobs, keypads and panic buttons",
        "type": "boolean",
        "default": true
      },
      "zoneBypassSwitches": {
        "title": "Add a bypass switch to each bypassable zone",
        "type": "boolean",
        "default": false,
        "description": "Turning a zone's bypass switch OFF clears ALL bypassed zones on that partition (API limitation)."
      },
      "zoneOverrides": {
        "title": "Zone Overrides",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "locationId": { "title": "Location ID (optional)", "type": "integer" },
            "zoneId": { "title": "Zone ID", "type": "integer", "required": true },
            "name": { "title": "Name (optional)", "type": "string" },
            "type": {
              "title": "Sensor Type",
              "type": "string",
              "default": "auto",
              "oneOf": [
                { "title": "Automatic", "enum": ["auto"] },
                { "title": "Contact (door/window)", "enum": ["contact"] },
                { "title": "Motion", "enum": ["motion"] },
                { "title": "Smoke", "enum": ["smoke"] },
                { "title": "Carbon Monoxide", "enum": ["carbonMonoxide"] },
                { "title": "Leak / Flood", "enum": ["leak"] },
                { "title": "Occupancy", "enum": ["occupancy"] },
                { "title": "Hidden", "enum": ["hidden"] }
              ]
            }
          }
        }
      },
      "pollingInterval": {
        "title": "Polling interval (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 10,
        "maximum": 3600,
        "description": "How often to fetch status from Total Connect. Lower values update faster but increase cloud traffic."
      },
      "fastPollingInterval": {
        "title": "Fast polling interval after a command (seconds)",
        "type": "integer",
        "default": 4,
        "minimum": 2,
        "maximum": 30
      },
      "requestTimeout": {
        "title": "Request timeout (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 5,
        "maximum": 120
      },
      "verboseLogging": {
        "title": "Verbose logging",
        "type": "boolean",
        "default": false,
        "description": "Log API activity at info level. Secrets are always redacted."
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "Account",
      "items": ["name", "username", "password", "userCode"]
    },
    {
      "type": "fieldset",
      "title": "Arming",
      "expandable": true,
      "expanded": true,
      "items": ["partitionMode", "homeMode", "nightMode", "awayMode", "allowDisarm"]
    },
    {
      "type": "fieldset",
      "title": "Automations & Extras",
      "expandable": true,
      "expanded": false,
      "items": ["autoBypassOnArm", "autoBypassLowBattery", "armingSwitches", "bypassSwitches", "alarmSensor"]
    },
    {
      "type": "fieldset",
      "title": "Zones",
      "expandable": true,
      "expanded": false,
      "items": [
        "zoneExposure",
        {
          "key": "zoneIds",
          "condition": { "functionBody": "return model.zoneExposure === 'selected';" },
          "type": "array",
          "items": ["zoneIds[]"]
        },
        {
          "key": "excludeZoneIds",
          "type": "array",
          "items": ["excludeZoneIds[]"]
        },
        "hideButtonZones",
        "zoneBypassSwitches",
        {
          "key": "zoneOverrides",
          "type": "array",
          "orderable": false,
          "buttonText": "Add Zone Override",
          "items": ["zoneOverrides[].locationId", "zoneOverrides[].zoneId", "zoneOverrides[].name", "zoneOverrides[].type"]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Multiple Locations",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "key": "locations",
          "type": "array",
          "orderable": false,
          "buttonText": "Add Location Settings",
          "items": ["locations[].locationId", "locations[].name", "locations[].userCode", "locations[].enabled"]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Advanced",
      "expandable": true,
      "expanded": false,
      "items": ["pollingInterval", "fastPollingInterval", "requestTimeout", "verboseLogging"]
    }
  ]
}

